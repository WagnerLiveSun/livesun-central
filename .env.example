# Copie para .env e gere três chaves diferentes. Não use valores deste exemplo em produção.
APP_ENV=development
SECRET_KEY=
JWT_SECRET=
ENCRYPTION_KEY=
DB_ENGINE=mysql
DATABASE_URL=mysql+pymysql://usuario:senha@localhost:3306/livesun_central
# Alternativa:
# DB_ENGINE=postgresql
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/livesun_central?sslmode=verify-full&sslrootcert=/path/ca.pem
# DB_SSL_CA=/path/mysql-ca.pem
WEBHOOK_ALLOWED_HOSTS=propostas.livesun.com.br
# Somente para testes na mesma máquina com APP_ENV=development.
WEBHOOK_ALLOW_LOCAL_HTTP=false
PROPOSTAS_WEBHOOK_SECRET=
# Desenvolvimento: memória. Produção: Redis compartilhado por todos os workers web.
RATELIMIT_STORAGE_URI=memory://
# Somente atrás de proxy confiável, com acesso direto ao serviço bloqueado.
TRUST_PROXY=false
# Opcional: primeira instalação em nuvem, executada pelo seed no pré-deploy.
# Remova a senha do ambiente após criar o primeiro operador.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_NAME=Administrador
# BOOTSTRAP_ADMIN_PASSWORD=