# Environment do Central: mesmos valores no web e no worker.
# Para MontuDB por SSH, utilize render.ssh.environment.example em vez deste modelo direto.
APP_ENV=production
PYTHON_VERSION=3.12.10
DB_ENGINE=postgresql
DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@HOST_ACESSIVEL:5432/DbCentral?sslmode=require
SECRET_KEY=PREENCHER_CHAVE_ALEATORIA_EXCLUSIVA
JWT_SECRET=PREENCHER_OUTRA_CHAVE_ALEATORIA_EXCLUSIVA
ENCRYPTION_KEY=PREENCHER_CHAVE_FERNET
RATELIMIT_STORAGE_URI=redis://HOST_REDIS:6379/0
WEBHOOK_ALLOWED_HOSTS=propostas.livesun.com.br,app.livesun.com.br
WEBHOOK_ALLOW_LOCAL_HTTP=false
TRUST_PROXY=true
# Primeira instalação apenas. Remover senha após primeiro acesso.
# BOOTSTRAP_ADMIN_EMAIL=SEU_EMAIL
# BOOTSTRAP_ADMIN_NAME=Administrador
# BOOTSTRAP_ADMIN_PASSWORD=SENHA_DEFINIDA_PELO_OPERADOR